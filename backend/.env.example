# Flask Server Configuration
FLASK_ENV=development
FLASK_APP=run.py
PORT=5000
SECRET_KEY=change-this-in-production-to-a-secure-random-string
CORS_ORIGINS=http://localhost:3000

# Google Gemini AI Configuration (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Server-Side Admin Configuration (Server-Side Only - NEVER expose to client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Supabase Anon / Publishable Key (for request-scoped user operations)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase JWT Verification Configuration (Server-Side Only)
# Supports legacy HS256 tokens using SUPABASE_JWT_SECRET and modern ECC P-256 / ES256 tokens using Supabase JWKS
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_JWT_AUDIENCE=authenticated
# Optional: Supabase JWKS endpoint for ECC P-256 / ES256 key verification
# Defaults to https://<your-project-id>.supabase.co/auth/v1/.well-known/jwks.json when SUPABASE_URL is set
# SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
# Optional: set issuer if enforcing iss claim verification (e.g. https://<project-ref>.supabase.co/auth/v1)
# SUPABASE_JWT_ISSUER=https://your-project-id.supabase.co/auth/v1
# Optional: required if SUPABASE_JWT_ALGORITHM is RS256 / ES256 with static public key
# SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Supabase Storage Configuration
STORAGE_EXPORTS_BUCKET=plan-exports

# Guest Session Policy
GUEST_INACTIVITY_RETENTION_DAYS=30
